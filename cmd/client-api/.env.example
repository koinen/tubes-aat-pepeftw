# Server
PORT=8080

# Redis Configuration (own instance for rate limiting)
REDIS_HOST=client-api-store
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka Configuration
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_AUTH_REVOCATIONS=auth-revocations
KAFKA_GROUP_ID=client-api-revocations

# Upstream Services
AGGREGATOR_URL=http://aggregator:8080
INTERNAL_API_KEY=change-me-internal-key
AUTH_JWKS_URL=http://auth:8080/.well-known/jwks.json

# JWT Verification
JWT_ISSUER=auth-service
JWT_AUDIENCE=bnpb-ops

# Rate Limiting
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60
