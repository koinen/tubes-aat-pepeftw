# Auth Service Configuration
PORT=8080

# Database Configuration
DB_HOST=auth-db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=mydb

# Kafka Configuration
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_AUTH_REVOCATIONS=auth-revocations

# Security
ACCESS_TOKEN_TTL=60 # seconds
REFRESH_TOKEN_TTL=604800 # seconds (7 days)

PRIVATE_KEY_PATH=./secrets/auth_priv.pem

JWT_ISSUER=your-issuer
JWT_AUDIENCE=your-audience

MEDIA_SECRET=change-me
LAPANGAN_SECRET=change-me
BNPB_SECRET=change-me