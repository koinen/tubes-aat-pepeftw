{
  "uid": "bnpb-services",
  "title": "Layanan BNPB",
  "tags": ["bnpb"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Service aktif",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (app) (up{job=\"bnpb\"})", "legendFormat": "{{app}}" }],
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Throughput (request per detik)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (service) (rate(bnpb_http_requests_total[1m]))", "legendFormat": "{{service}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error rate (persen respons 5xx)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "refId": "A",
        "expr": "100 * sum by (service) (rate(bnpb_http_requests_total{status=~\"5..\"}[1m]) or rate(bnpb_http_requests_total[1m]) * 0) / sum by (service) (rate(bnpb_http_requests_total[1m]))",
        "legendFormat": "{{service}}"
      }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0 } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latensi p95",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "refId": "A",
        "expr": "histogram_quantile(0.95, sum by (service, le) (rate(bnpb_http_request_duration_seconds_bucket[1m])))",
        "legendFormat": "{{service}}"
      }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latensi p95 per route aggregator",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "refId": "A",
        "expr": "histogram_quantile(0.95, sum by (route, le) (rate(bnpb_http_request_duration_seconds_bucket{service=\"aggregator\"}[1m])))",
        "legendFormat": "{{route}}"
      }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Kafka: pesan dipublikasikan dan dikonsumsi per detik",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "refId": "A",
        "expr": "sum by (service, direction) (rate(bnpb_kafka_messages_total[1m]))",
        "legendFormat": "{{service}} {{direction}}"
      }],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Kafka: waktu proses pesan p95",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "refId": "A",
        "expr": "histogram_quantile(0.95, sum by (service, le) (rate(bnpb_kafka_handle_duration_seconds_bucket[1m])))",
        "legendFormat": "{{service}}"
      }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ]
}
