{
  "uid": "bnpb-satellite",
  "title": "Feed Satelit (P4)",
  "tags": ["bnpb", "satelit"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Tertinggal dari feed (offset)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "max(bnpb_satellite_lag_offsets)" }],
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5000 }, { "color": "red", "value": 50000 }] }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Perkiraan mengejar feed (detik)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "max(bnpb_satellite_catchup_eta_seconds)" }],
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 30 }, { "color": "red", "value": 60 }] }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Deteksi melewati batas keterlambatan",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "max(bnpb_satellite_late_detections)" }],
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Kecepatan waktu feed",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "max(bnpb_satellite_feed_speed)" }],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "x" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Ketertinggalan dari feed (offset)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "max(bnpb_satellite_feed_head_offset)", "legendFormat": "offset terbaru di feed" },
        { "refId": "B", "expr": "max(bnpb_satellite_applied_offset)", "legendFormat": "offset yang sudah diterapkan" },
        { "refId": "C", "expr": "max(bnpb_satellite_lag_offsets)", "legendFormat": "selisih (lag)" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latensi data masuk sampai HazardEvent tersimpan",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(bnpb_satellite_event_to_hazard_seconds_bucket[2m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(bnpb_satellite_event_to_hazard_seconds_bucket[2m])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(bnpb_satellite_event_to_hazard_seconds_bucket[2m])))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Kebakaran dan deteksi tunggal",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "max(bnpb_satellite_fires)", "legendFormat": "kebakaran" },
        { "refId": "B", "expr": "max(bnpb_satellite_singles)", "legendFormat": "deteksi tunggal (bukan kebakaran)" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Deteksi aktif dan deteksi terlambat",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "max(bnpb_satellite_active_detections)", "legendFormat": "deteksi aktif" },
        { "refId": "B", "expr": "max(bnpb_satellite_late_detections)", "legendFormat": "melewati batas keterlambatan" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    }
  ]
}
