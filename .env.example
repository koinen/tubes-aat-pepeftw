# Database configuration
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=

# Kafka
# Containers pake kafka:9092. Tools di host pake localhost:9094.
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_HAZARD_EVENTS=hazard-events
KAFKA_TOPIC_AUTH_REVOCATIONS=auth-revocations

# One consumer group per logical consumer. Never share a group id, or fan-out breaks.
KAFKA_GROUP_ID_DASHBOARD=dashboard-updater
KAFKA_GROUP_ID_NOTIFIER=notifier
KAFKA_GROUP_ID_AUDIT=audit-log
KAFKA_GROUP_ID_CLIENT_API_REVOCATIONS=client-api-revocations

# Aggregator internal API. client-api sends the same value as X-Internal-Key.
INTERNAL_API_KEY=change-me-internal-key
SEED_FIXTURES=true


# Logging (DEBUG / INFO / WARN / ERROR)
LOG_LEVEL=INFO

# BMKG mock (bmkg-mock) dan kredensial BMKG milik Aggregator
BMKG_API_KEY=bmkg_ganti_dengan_key_acak
BMKG_DELAY_MIN=50ms
BMKG_DELAY_MAX=150ms
BMKG_EVENT_INTERVAL=5s
BMKG_SEED_COUNT=25
BMKG_TSUNAMI_RATE=0.15

# PVMBG mock (pvmbg-mock) dan kredensial PVMBG milik Aggregator
PVMBG_TOKEN_SECRET=ganti-dengan-secret-acak-panjang
# PVMBG_TOKEN harus dibuat ulang setiap PVMBG_TOKEN_SECRET diganti:
#   docker compose run --rm pvmbg-mock ./pvmbg-mock gen-token bnpb-aggregator
PVMBG_TOKEN=pvmbg.bnpb-aggregator.Nita3cmwl0EjrICAXvJSpPEZHjQpLWVshlg8IhX3Dic
PVMBG_ADMIN_KEY=ganti-dengan-admin-key
PVMBG_DELAY_MIN=500ms
PVMBG_DELAY_MAX=3000ms
PVMBG_REPORT_INTERVAL=5s
PVMBG_SEED_COUNT=25
PVMBG_SCHEMA_VERSION=1
PVMBG_HANG_MAX=5m

# Poller Aggregator
POLLER_ENABLED=true
POLL_INTERVAL=3s
BMKG_TIMEOUT=1s

PVMBG_TIMEOUT=4s

POLL_CURSOR_OVERLAP=1m
BREAKER_FAILURES=3
BREAKER_OPEN_FOR=15s
TSUNAMI_GRACE=30s

# ...
